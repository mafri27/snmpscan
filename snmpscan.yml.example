# Copy to /etc/snmpscan, ~/.snmpscan or ./.snmpscan as snmpscan.yml.
# Every value below is also the built-in default, so an absent file changes
# nothing.

# Seconds between value polls; -i overrides it. 0 polls back to back.
interval: 10

thresholds:
  # A row whose rates all stay below this is greyed out as uninteresting.
  dim:
    mbit: 5
    pps: 100
  # A row reaching any of these turns red.
  alert:
    mbit: 700
    pps: 100000
    errors: 1

# Seconds between re-reads of the interface list, which runs alongside the
# value polls on its own connections. Omit it to follow `interval`; 0 runs it
# back to back. On a large device this is most of the SNMP traffic, so raise
# it if you want to be gentle on the agent.
# discovery: 300
